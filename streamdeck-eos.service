[Unit]
Description=Stream Deck EOS Macro Controller
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/artios-lighting-buttons
ExecStart=/home/pi/artios-lighting-buttons/venv/bin/python streamdeck_eos.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
